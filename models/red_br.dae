            <bind_material>
              <technique_common>
                <instance_material symbol="ones-material" target="#ones-material">
                  <bind_vertex_input semantic="UVMap" input_semantic="TEXCOORD" input_set="0"/>
                </instance_material>
                <instance_material symbol="battle_rifle_knob-material" target="#battle_rifle_knob-material">
                  <bind_vertex_input semantic="UVMap" input_semantic="TEXCOORD" input_set="0"/>
                </instance_material>
                <instance_material symbol="battle_rifle_metal-material" target="#battle_rifle_metal-material">
                  <bind_vertex_input semantic="UVMap" input_semantic="TEXCOORD" input_set="0"/>
                </instance_material>
                <instance_material symbol="battle_rifle_plastic-material" target="#battle_rifle_plastic-material">
                  <bind_vertex_input semantic="UVMap" input_semantic="TEXCOORD" input_set="0"/>
                </instance_material>
                <instance_material symbol="tens-material" target="#tens-material">
                  <bind_vertex_input semantic="UVMap" input_semantic="TEXCOORD" input_set="0"/>
                </instance_material>
              </technique_common>
            </bind_material>
          </instance_controller>
        </node>
      </node>
    </visual_scene>
  </library_visual_scenes>
  <scene>
    <instance_visual_scene url="#Scene"/>
