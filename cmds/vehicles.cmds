SaveTagChanges
exit

EditTag objects\vehicles\banshee\banshee.vehicle
SetField Model custom\vehicles\tgof_hce_banshee\banshee.model
SaveTagChanges
exit

echo ghost

opencachefile "h2maps\zanzibar.map"
Porttag replace objects\vehicles\ghost\ghost.model
porttag replace objects\vehicles\ghost\garbage\hull_shell\hull_shell.model
porttag replace objects\vehicles\ghost\garbage\seat\seat.model
Exit

OpenCacheFile "h3maps\zanzibar.map"
porttag replace objects\vehicles\ghost\ghost.physics_model
Exit

EditTag objects\vehicles\ghost\ghost.render_model
SetField Materials[2].RenderMethod null
SaveTagChanges
Exit

Edittag objects\vehicles\ghost\shaders\ghost_dash.shader
SetArgument self_illum_color 1 1 1 0
savetagchanges
exit

Edittag objects\vehicles\ghost\ghost.vehicle
