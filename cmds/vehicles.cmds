SetField NewDamageInfo[0].DamageSections[1].InstantResponses[6].PrimaryTransitionEffect objects\vehicles\ghost\fx\destruction\perm_hull_major.effect
SetField NewDamageInfo[0].DamageSections[3].InstantResponses[1].PrimaryTransitionEffect objects\vehicles\ghost\fx\destruction\perm_wing_medium.effect
SetField NewDamageInfo[0].DamageSections[3].InstantResponses[2].PrimaryTransitionEffect objects\vehicles\ghost\fx\destruction\perm_wing_major.effect
SetField NewDamageInfo[0].DamageSections[4].InstantResponses[1].PrimaryTransitionEffect objects\vehicles\ghost\fx\destruction\perm_hull_medium.effect
SetField NewDamageInfo[0].DamageSections[4].InstantResponses[2].PrimaryTransitionEffect objects\vehicles\ghost\fx\destruction\perm_wing_major.effect
