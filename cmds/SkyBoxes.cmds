
Echo Ascension

EditTag scenarios\skies\multi\ascension\ascension.render_model
SetField Nodes[0].DefaultScale 50
SetField Materials[5].RenderMethod null
savetagchanges
Exit

Duplicatetag levels\multi\riverworld\sky\riverworld.sky_atm_parameters levels\multi\ascension\sky\ascension

Edittag scenarios\multi\ascension\ascension.scenario
SetField SkyParameters levels\multi\ascension\sky\ascension.sky_atm_parameters
savetagchanges
exit

Edittag levels\multi\ascension\sky\ascension.sky_atm_parameters
SetField AtmosphereSettings[0].Color 0.56578946 0.56578946 0.56578946
SetField AtmosphereSettings[0].Intensity 1
SetField AtmosphereSettings[0].SeaLevel 255
SetField AtmosphereSettings[0].RayleignHeightScale 255
SetField AtmosphereSettings[0].MieHeightScale 6
SetField AtmosphereSettings[0].RayleighMultiplier 0.05
SetField AtmosphereSettings[0].MieMultiplier 0.025
SetField AtmosphereSettings[0].SunPhaseFunction 0
SetField AtmosphereSettings[0].DistanceBias 5
SetField AtmosphereSettings[0].MaxFogThickness 1000000
SetField AtmosphereSettings[0].BetaM 0.00029466028 0.00050242565 0.0010586029
SetField AtmosphereSettings[0].SheetDensity 0
SetField AtmosphereSettings[0].FullIntensityHeight 0
SetField AtmosphereSettings[0].HalfIntensityHeight 0
SetField AtmosphereSettings[0].WindDirection 55 255 0
SetField AtmosphereSettings[0].RuntimeWeight 0
SetField AtmosphereSettings[0].RuntimeEffectWeight 55
savetagchanges
exit

Edittag scenarios\multi\ascension\ascension.scenario
importmapvariant MapFile "workingdir\map_variants\Ascension\sandbox.map"
Exit


Echo Backwash

Edittag scenarios\multi\backwash\backwash.scenario
importmapvariant MapFile "workingdir\map_variants\backwash\sandbox.map"
Exit

Echo BeaverCreek

Edittag scenarios\skies\multi\halo\coagulation\coagulation.render_model
SetField Materials[5].RenderMethod null
savetagchanges
Exit

echo Colossus

EditTag scenarios\skies\solo\alphagasgiant\alphagasgiant.render_model
SetField Nodes[0].DefaultScale 50
savetagchanges
exit


echo headlong

EditTag scenarios\skies\multi\ascension\ascension.render_model
SetField Materials[2].RenderMethod null
savetagchanges
Exit

echo lockout

edittag scenarios\skies\multi\lockout\lockout.render_model
SetField Nodes[0].DefaultScale 1
SetField Materials[4].RenderMethod null
SetField Materials[5].RenderMethod null
Savetagchanges
Exit


echo midship

EditTag scenarios\skies\multi\midship\midship.render_model
SetField Nodes[0].DefaultScale 5
savetagchanges
exit

EditTag scenarios\skies\multi\midship\shaders\space.shader
SetField ShaderProperties[0].BlendMode Opaque
savetagchanges
exit


echo Relic

EditTag scenarios\skies\multi\dune\dune.render_model
SetField Nodes[0].DefaultScale 2
Savetagchanges
exit

echo Sanctuary

EditTag scenarios\skies\multi\deltatap\deltatap.render_model
SetField Nodes[0].DefaultScale 5
savetagchanges
exit


























