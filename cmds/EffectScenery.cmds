#echo Ascension

#Ascension JumpPad
DuplicateTag levels\multi\s3d_avalanche\fx\s3d_avalanche_effect_scenery_16.effect_scenery fx\distortion
DuplicateTag levels\multi\s3d_avalanche\fx\s3d_avalanche_effect_scenery_16_light_volume.effect fx\distortion\effect

EditTag fx\distortion\effect.effect
RemoveBlockElements Events[0].Parts 0 1
SetField Events[0].ParticleSystems[0].Particle null
SetField Events[0].ParticleSystems[1].Particle null
SetField Events[0].ParticleSystems[2].Particle null
SetField Events[0].ParticleSystems[3].LodOutDistance 1000
SaveTagChanges
Exit

EditTag fx\distortion.effect_scenery
SetField Attachments[0].Type fx\distortion\effect.effect
SaveTagChanges
Exit

EditTag scenarios\multi\ascension\ascension.scenario

AddBlockElements EffectScenery

SetField EffectScenery[0].Position 16.138 -5.384 -5.215
SetField EffectScenery[0].Rotation 84.624 -57.91 3.6309998
SetField EffectScenery[0].NameIndex -1
SetField EffectScenery[0].EditingBoundToBsp -1
SetField EffectScenery[0].EditorFolder -1
