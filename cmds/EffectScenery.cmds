SetField EffectScenery[0].ParentId.NameIndex -1
SetField EffectScenery[0].ObjectId.Source Editor
SetField EffectScenery[0].ObjectId.Type.Halo3ODST EffectScenery

AddBlockElements EffectSceneryPalette

SetField EffectSceneryPalette[0].Object fx\distortion.effect_scenery

SaveTagChanges
Exit
