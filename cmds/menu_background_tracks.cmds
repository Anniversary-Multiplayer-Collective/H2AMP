# ECHO SETUP MAIN MENU TRACKS

# BITMAP MUST BE MADE HORIZONTALLY TILEABLE
# BITMAP WIDTH: 4096
# SCALE BOUNDS: BITMAP WIDTH * 1
# LEFT SIDE BOUND: SCALE BOUNDS * -0.5
# RIGHT SIDE BOUND: SCALE BOUNDS * 0.5

SetVariable left_bound -2048
SetVariable right_bound 2048

SetVariable fast_speed 10000
SetVariable medium_speed 20000
SetVariable slow_speed 40000

# TRACK BITMAPS
GenerateBitmap ui\halox\h2\track1 "workingdir\bitmaps\tracks\track1.dds"
GenerateBitmap ui\halox\h2\track2b "workingdir\bitmaps\tracks\track2b.dds"
GenerateBitmap ui\halox\h2\track3 "workingdir\bitmaps\tracks\track3.dds"
GenerateBitmap ui\halox\h2\track4 "workingdir\bitmaps\tracks\track4.dds"
GenerateBitmap ui\halox\h2\track5 "workingdir\bitmaps\tracks\track5.dds"
GenerateBitmap ui\halox\h2\track6 "workingdir\bitmaps\tracks\track6.dds"
GenerateBitmap ui\halox\h2\track7a "workingdir\bitmaps\tracks\track7a.dds"
GenerateBitmap ui\halox\h2\track7b "workingdir\bitmaps\tracks\track7b.dds"
GenerateBitmap ui\halox\h2\track7c "workingdir\bitmaps\tracks\track7c.dds"
GenerateBitmap ui\halox\h2\track7d "workingdir\bitmaps\tracks\track7d.dds"
GenerateBitmap ui\halox\h2\track7e "workingdir\bitmaps\tracks\track7e.dds"
GenerateBitmap ui\halox\h2\track7f "workingdir\bitmaps\tracks\track7f.dds"
GenerateBitmap ui\halox\h2\track8 "workingdir\bitmaps\tracks\track8.dds"
GenerateBitmap ui\halox\h2\track_timeline "workingdir\bitmaps\tracks\track_timeline.dds"
GenerateBitmap ui\halox\h2\track_timeline2a "workingdir\bitmaps\tracks\track_timeline2a.dds"
GenerateBitmap ui\halox\h2\track_timeline2b "workingdir\bitmaps\tracks\track_timeline2b.dds"

# SCROLL ANIMATION FAST
CreateTag wtuv ui\halox\h2\scrolling_tracks_fast
EditTag ui\halox\h2\scrolling_tracks_fast.gui_widget_texture_coordinate_animation_definition
SetField Flags LoopCyclic
AddBlockElements Keyframes
SetField Keyframes[*].TimeOffset 0
SetField Keyframes[*].UVs 0 0
AddBlockElements Keyframes
SetField Keyframes[*].TimeOffset fast_speed
SetField Keyframes[*].UVs -1 0
SetField DefaultFunction.Data 08340000000000000000803F00000000000000000000000000000000140000000100000004000000FFFF7F7F0000803F00000000
SaveTagChanges
Exit

CreateTag wgan ui\halox\h2\scrolling_tracks_fast
EditTag ui\halox\h2\scrolling_tracks_fast.gui_widget_animation_definition
SetField TextureCoordinateAnimation ui\halox\h2\scrolling_tracks_fast.gui_widget_texture_coordinate_animation_definition
SaveTagChanges
Exit

# SCROLL ANIMATION MEDIUM
DuplicateTag ui\halox\h2\scrolling_tracks_fast.gui_widget_texture_coordinate_animation_definition ui\halox\h2\scrolling_tracks_medium
EditTag ui\halox\h2\scrolling_tracks_medium.gui_widget_texture_coordinate_animation_definition
SetField Keyframes[*].TimeOffset medium_speed
SaveTagChanges
Exit

CreateTag wgan ui\halox\h2\scrolling_tracks_medium
EditTag ui\halox\h2\scrolling_tracks_medium.gui_widget_animation_definition
SetField TextureCoordinateAnimation ui\halox\h2\scrolling_tracks_medium.gui_widget_texture_coordinate_animation_definition
SaveTagChanges
Exit

# SCROLL ANIMATION SLOW
DuplicateTag ui\halox\h2\scrolling_tracks_fast.gui_widget_texture_coordinate_animation_definition ui\halox\h2\scrolling_tracks_slow
EditTag ui\halox\h2\scrolling_tracks_slow.gui_widget_texture_coordinate_animation_definition
SetField Keyframes[*].TimeOffset slow_speed
SaveTagChanges
Exit

CreateTag wgan ui\halox\h2\scrolling_tracks_slow
EditTag ui\halox\h2\scrolling_tracks_slow.gui_widget_animation_definition
SetField TextureCoordinateAnimation ui\halox\h2\scrolling_tracks_slow.gui_widget_texture_coordinate_animation_definition
SaveTagChanges
Exit

# HIDE ANIMATION
CreateTag wscl ui\halox\h2\scrolling_tracks_hide
EditTag ui\halox\h2\scrolling_tracks_hide.gui_widget_scale_animation_definition
AddBlockElements Keyframes
SetField Keyframes[*].TimeOffset 0
SetField Keyframes[*].ScaleFactor 0 0
AddBlockElements Keyframes
SetField Keyframes[*].TimeOffset 100
SetField Keyframes[*].ScaleFactor 0 0
SetField DefaultFunction.Data 08340000000000000000803F00000000000000000000000000000000140000000100000004000000FFFF7F7F0000803F00000000
SaveTagChanges
Exit

CreateTag wgan ui\halox\h2\scrolling_tracks_hide
EditTag ui\halox\h2\scrolling_tracks_hide.gui_widget_animation_definition
SetField ScaleAnimation ui\halox\h2\scrolling_tracks_hide.gui_widget_scale_animation_definition
SaveTagChanges
Exit

# SHOW ANIMATION
DuplicateTag ui\halox\h2\scrolling_tracks_hide.gui_widget_scale_animation_definition ui\halox\h2\scrolling_tracks_show
EditTag ui\halox\h2\scrolling_tracks_show.gui_widget_scale_animation_definition
SetField Keyframes[0].ScaleFactor 1 1
SetField Keyframes[1].ScaleFactor 1 1
SaveTagChanges
Exit

CreateTag wgan ui\halox\h2\scrolling_tracks_show
EditTag ui\halox\h2\scrolling_tracks_show.gui_widget_animation_definition
SetField ScaleAnimation ui\halox\h2\scrolling_tracks_show.gui_widget_scale_animation_definition
SaveTagChanges
Exit

# ANIMATION EVENTS FAST
CreateTag wacd ui\halox\h2\scrolling_tracks_fast
EditTag ui\halox\h2\scrolling_tracks_fast.gui_widget_animation_collection_definition
SetField AmbientUnfocused ui\halox\h2\scrolling_tracks_fast.gui_widget_animation_definition
SetField TransitionFrom ui\halox\h2\scrolling_tracks_hide.gui_widget_animation_definition
SetField TransitionTo ui\halox\h2\scrolling_tracks_show.gui_widget_animation_definition
SaveTagChanges
Exit

# ANIMATION EVENTS MEDIUM
DuplicateTag ui\halox\h2\scrolling_tracks_fast.gui_widget_animation_collection_definition ui\halox\h2\scrolling_tracks_medium
EditTag ui\halox\h2\scrolling_tracks_medium.gui_widget_animation_collection_definition
SetField AmbientUnfocused ui\halox\h2\scrolling_tracks_medium.gui_widget_animation_definition
SaveTagChanges
Exit

# ANIMATION EVENTS SLOW
DuplicateTag ui\halox\h2\scrolling_tracks_fast.gui_widget_animation_collection_definition ui\halox\h2\scrolling_tracks_slow
EditTag ui\halox\h2\scrolling_tracks_slow.gui_widget_animation_collection_definition
SetField AmbientUnfocused ui\halox\h2\scrolling_tracks_slow.gui_widget_animation_definition
SaveTagChanges
Exit

# TRACK WIDGETS TEMPLATE
CreateTag grup ui\halox\h2\scrolling_tracks
EditTag ui\halox\h2\scrolling_tracks.gui_group_widget_definition
SetField Flags DoNotApplyOldContentUpscaling
AddBlockElements BitmapWidgets
SetField BitmapWidgets[*].Definition.GuiRenderBlock.Bounds720p 100 left_bound 116 right_bound
SetField BitmapWidgets[*].Definition.GuiRenderBlock.Bounds480i 100 left_bound 116 right_bound
SetField BitmapWidgets[*].Definition.GuiRenderBlock.AnimationCollection ui\halox\h2\scrolling_tracks_medium.gui_widget_animation_collection_definition
SetField BitmapWidgets[*].Definition.Bitmap ui\halox\h2\track1.bitmap
