SetField BitmapWidgets[*].Definition.GuiRenderBlock.Bounds720p 150 left_bound 166 right_bound
SetField BitmapWidgets[*].Definition.GuiRenderBlock.Bounds480i 150 left_bound 166 right_bound
SetField BitmapWidgets[*].Definition.GuiRenderBlock.AnimationCollection ui\halox\h2\scrolling_tracks_slow.gui_widget_animation_collection_definition
