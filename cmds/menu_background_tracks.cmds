SetField BitmapWidgets[*].Definition.GuiRenderBlock.AnimationCollection ui\halox\h2\scrolling_tracks_slow.gui_widget_animation_collection_definition
SetField BitmapWidgets[*].Definition.Bitmap ui\halox\h2\track_timeline2b.bitmap
ForEach BitmapWidgets SetField Definition.Flags DoNotApplyOldContentUpscaling,ScaleToFitBounds
ForEach BitmapWidgets SetField Definition.GuiRenderBlock.ScaledPositioning LeftEdge
ForEach BitmapWidgets SetField Definition.GuiRenderBlock.RenderDepthBias -49
ForEach BitmapWidgets SetField Definition.BlendMethod AlphaBlend
SaveTagChanges
Exit

# APPLY TO ALL LOBBY SCREENS
ForEach scn3 contains: main_menu\main_menu AddBlockElements GroupWidgets
ForEach scn3 contains: main_menu\main_menu SetField GroupWidgets[*].TemplateReference ui\halox\h2\scrolling_tracks.gui_group_widget_definition
ForEach scn3 contains: main_menu\main_menu SetField GroupWidgets[*].Definition.Flags DoNotApplyOldContentUpscaling
ForEach scn3 contains: main_menu\main_menu SetField GroupWidgets[*].Definition.GuiRenderBlock.Bounds720p 1 -700 0 0
ForEach scn3 contains: main_menu\main_menu SetField GroupWidgets[*].Definition.GuiRenderBlock.Bounds480i 1 -400 0 0
ForEach scn3 contains: pregame_lobby\pregame_lobby AddBlockElements GroupWidgets
ForEach scn3 contains: pregame_lobby\pregame_lobby SetField GroupWidgets[*].TemplateReference ui\halox\h2\scrolling_tracks.gui_group_widget_definition
ForEach scn3 contains: pregame_lobby\pregame_lobby SetField GroupWidgets[*].Definition.Flags DoNotApplyOldContentUpscaling
ForEach scn3 contains: pregame_lobby\pregame_lobby SetField GroupWidgets[*].Definition.GuiRenderBlock.Bounds720p 1 -10 0 0
ForEach scn3 contains: pregame_lobby\pregame_lobby SetField GroupWidgets[*].Definition.GuiRenderBlock.Bounds480i 1 -10 0 0
